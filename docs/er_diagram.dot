digraph ER {
  rankdir=TB; nodesep=0.5; ranksep=0.9; fontname="Helvetica"; node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [fontname="Helvetica", fontsize=9, arrowhead=crow, arrowtail=none];
  branches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F4F6FA"><TR><TD BGCOLOR="#DDEBFF"><B>branches</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>name (unique)<BR ALIGN="LEFT"/>area<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  membership_tiers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F4F6FA"><TR><TD BGCOLOR="#DDEBFF"><B>membership_tiers</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>name, max_loans, loan_days<BR ALIGN="LEFT"/>max_renewals, annual_fee_paise<BR ALIGN="LEFT"/>fine_policy, fine_rate_paise<BR ALIGN="LEFT"/>grace_days, fine_cap_paise<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  members [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F4F6FA"><TR><TD BGCOLOR="#DDEBFF"><B>members</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>name, email (unique), phone<BR ALIGN="LEFT"/>FK tier_id, FK home_branch_id<BR ALIGN="LEFT"/>joined_on, status<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  books [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F4F6FA"><TR><TD BGCOLOR="#DDEBFF"><B>books</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>isbn (unique), title<BR ALIGN="LEFT"/>author, genre, published_year<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  copies [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F4F6FA"><TR><TD BGCOLOR="#DDEBFF"><B>copies</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK book_id, FK branch_id<BR ALIGN="LEFT"/>barcode (unique)<BR ALIGN="LEFT"/>status: available / on_loan / held / lost<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  loans [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F4F6FA"><TR><TD BGCOLOR="#DDEBFF"><B>loans</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK copy_id, FK member_id<BR ALIGN="LEFT"/>issued_on, due_on, returned_on<BR ALIGN="LEFT"/>renewals<BR ALIGN="LEFT"/><I>unique: one open loan per copy</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  reservations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F4F6FA"><TR><TD BGCOLOR="#DDEBFF"><B>reservations</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK book_id, FK member_id<BR ALIGN="LEFT"/>FK held_copy_id (nullable)<BR ALIGN="LEFT"/>created_at, status, expires_on<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  fines [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#F4F6FA"><TR><TD BGCOLOR="#DDEBFF"><B>fines</B></TD></TR><TR><TD ALIGN="LEFT">PK id<BR ALIGN="LEFT"/>FK loan_id (unique), FK member_id<BR ALIGN="LEFT"/>amount_paise, created_on, paid_on<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  holidays [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FFF4D6"><TR><TD><B>holidays</B></TD></TR><TR><TD ALIGN="LEFT">PK day, name<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  raw [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FDE3E3"><TR><TD><B>loan_history_raw</B> (staging)</TD></TR><TR><TD ALIGN="LEFT">untyped legacy rows<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  quar [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#FDE3E3"><TR><TD><B>loan_quarantine</B></TD></TR><TR><TD ALIGN="LEFT">raw_id, reason, action<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  membership_tiers -> members [label="1 : N"]; branches -> members [label="home"]; branches -> copies [label="1 : N"];
  books -> copies [label="1 : N"]; copies -> loans [label="1 : N"]; members -> loans [label="1 : N"];
  books -> reservations; members -> reservations; copies -> reservations [style=dashed, label="holds"];
  loans -> fines [label="1 : 0..1"]; members -> fines; raw -> quar [style=dashed, label="audit"]; raw -> loans [style=dashed, label="cleaned into"];
}
